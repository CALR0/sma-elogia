# ======================================================================
#  Migracion de anticipos a SAP - variables de entorno
#  Copia este archivo como  .env  y completa los valores.
#  En Vercel se configuran en Project Settings > Environment Variables.
# ======================================================================

# Clave para cifrar la sesion (AES-256-GCM). OBLIGATORIA en produccion.
# Minimo 32 caracteres aleatorios. Genera una: openssl rand -base64 48
SESSION_SECRET=

# --- Silogtran (login por usuario) ---
SILOG_BASE_URL=https://construproyec.colombiasoftware.net
SILOGTRAN_INTERFAZ_ID=139
SILOGTRAN_INTERFAZ_TEXT=QAS DAABON OC SAP
SILOGTRAN_FECHA_INI=2026-01-01
SILOGTRAN_FECHA_FIN=2030-01-01

# --- AWS (creacion y confirmacion de anticipos) ---
AWS_API_BASE=https://uss5a626ei.execute-api.sa-east-1.amazonaws.com/prod
# Secreta: header x-api-key del POST /events. Nunca se expone al navegador.
X_API_KEY=coloca_aqui_tu_api_key
# true = no crea anticipos reales (confirma via GET /logs). Tambien se activa
# solo si X_API_KEY sigue siendo el placeholder.
SIMULATE_CREATE=true

# --- AWS WAF (desafio de Silogtran) ---
# En Vercel se resuelve con @sparticuz/chromium (no requiere configuracion).
# En local/VM, apunta a tu Chrome/Chromium del sistema, p.ej. en Windows:
#   WAF_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# WAF_CHROME_PATH=
# WAF_ESPERA_SEG=30
# WAF_NAVEGADOR=1          # 0 = desactiva resolver el WAF con navegador
# Alternativa: delegar el token a otra instancia con navegador (worker):
# WAF_WORKER_URL=
# WAF_WORKER_SECRET=

# --- Solo local ---
PORT=3001
HOST=127.0.0.1
